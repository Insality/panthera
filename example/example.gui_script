local log = require("log.log")
local druid = require("druid.druid")
local event = require("event.event")
local events = require("event.events")
local panthera = require("panthera.panthera")

local list_view = require("example.components.list_view.list_view")
local timeline = require("example.components.timeline.timeline")
local properties_panel = require("example.components.properties_panel.properties_panel")
local examples_list = require("example.examples.examples_list")

local OUTPUT_LINES = 8
local MAX_SPEED = 5
local IS_LOOP_BY_DEFAULT = true

local ACCENT_PRIMARY = vmath.vector4(0.894, 0.506, 0.333, 1)
local ACCENT_SECONDARY = vmath.vector4(0.6, 0.502, 0.902, 1)

---The easing is applied over the whole animation timeline. Panthera plays the animation
---with a tweener instead of the timer when the easing is not "linear".
---
---Cycling through all forty easings in one property takes too many clicks, so the mode and the
---type are picked separately and composed into the name the tweener knows
local EASING_MODES = { "in", "out", "inout", "outin" }
local EASING_TYPES = {
	"linear", "sine", "quad", "cubic", "quart", "quint",
	"expo", "circ", "back", "elastic", "bounce",
}

local DEFAULT_EASING_MODE = 2 -- out
local DEFAULT_EASING_TYPE = 1 -- linear

---An animation track. Both tracks animate the same example over their own animation state, so
---they run independently and can be at different times.
---@class example.track
---@field timeline example.timeline
---@field options panthera.options The playback options of this track
---@field animation panthera.animation|nil
---@field animation_id string|nil
---@field display_time number

---@class example.gui_script
---@field druid druid.instance
---@field examples_list_view example.list_view
---@field animations_list_view example.list_view
---@field properties_panel example.properties_panel
---@field tracks example.track[] The primary track is always the first one
---@field example example.example|nil The currently selected example
---@field play_all example.play_all|nil The state of the Play All run, nil when it is not running
---@field container_root druid.container
---@field container_left druid.container
---@field container_header druid.container
---@field container_examples druid.container
---@field container_right druid.container
---@field container_animations druid.container
---@field container_center druid.container
---@field container_timeline druid.container
---@field container_timeline_second druid.container
---@field container_settings druid.container

---Plays every animation of every example one after another. It walks the examples list and the
---animations list, waiting for the primary track to finish before moving to the next animation.
---@class example.play_all
---@field example_index number
---@field animation_index number
---@field is_advancing boolean True while the run selects an item itself, so the selection
---events can tell an automatic step from a click of the user


---Containers describe the layout of the GUI scene. The components are placed inside them,
---so the layout can be changed in the GUI scene without touching the code.
---@param self example.gui_script
local function setup_layout(self)
	self.container_root = self.druid:new_container("root") --[[@as druid.container]]

	self.container_left = self.container_root:add_container("container_left", "stretch_y")
	self.container_header = self.container_left:add_container("container_header")
	self.container_examples = self.container_left:add_container("container_examples")

	self.container_right = self.container_root:add_container("container_right", "stretch_y")
	self.container_animations = self.container_right:add_container("container_animations")
	self.container_settings = self.container_right:add_container("container_settings")

	self.container_center = self.container_root:add_container("container_center")
	self.container_timeline = self.container_center:add_container("container_timeline", "stretch_x")
	self.container_timeline_second = self.container_center:add_container("container_timeline_second", "stretch_x")

	self.container_center:add_container("text_source_path")
	self.container_center:add_container("text_memory_usage")
end


---Append the line to the output. The repeated lines are collapsed into a single one,
---so the events triggered every frame are not flooding the output.
---@param self example.gui_script
---@param id string
---@param text string
local function add_output(self, id, text)
	local last = self.output[#self.output]
	if last and last.id == id then
		last.text = text
		last.count = last.count + 1
	else
		table.insert(self.output, { id = id, text = text, count = 1 })
	end

	while #self.output > OUTPUT_LINES do
		table.remove(self.output, 1)
	end

	local lines = {}
	for index = 1, #self.output do
		local line = self.output[index]
		lines[index] = line.count > 1 and (line.text .. "  x" .. line.count) or line.text
	end

	gui.set_text(self.node_text_output, table.concat(lines, "\n"))
end


---@param self example.gui_script
local function clear_output(self)
	self.output = {}
	gui.set_text(self.node_text_output, "")
end


---Rebuilds the properties panel, declared here because it is used before it is defined
---@type fun(self: example.gui_script)
local setup_settings


---@param track example.track
---@return number duration The duration of the animation of the track in seconds
local function get_duration(track)
	if not track.animation or not track.animation_id then
		return 0
	end

	return panthera.get_duration(track.animation, track.animation_id)
end


---The GUI examples are animated right here, while the collection and the game object examples
---are animated by `/example/scene/scene.script`: Panthera uses the `go.*` functions for them
---and those are not available in the GUI script context. Reading the animation state is fine
---from anywhere, only the calls that touch the objects have to be forwarded.
---@param self example.gui_script
---@return boolean is_world True if the current example is spawned into the world
local function is_world_example(self)
	return self.example ~= nil and self.example.template == nil
end


---@param self example.gui_script
---@param track example.track
local function panthera_play(self, track)
	if is_world_example(self) then
		events.trigger("example.scene.play", track.animation, track.animation_id, track.options)
	else
		panthera.play(track.animation, track.animation_id, track.options)
	end
end


---@param self example.gui_script
---@param track example.track
local function panthera_stop(self, track)
	-- `panthera.stop` remembers the animation it stopped, so the next `panthera.play` can reset
	-- its nodes back to the initial state. Stopping an already stopped animation forgets it and
	-- the nodes stay frozen in their last animated state
	if not track.animation or not panthera.is_playing(track.animation) then
		return
	end

	if is_world_example(self) then
		events.trigger("example.scene.stop", track.animation)
	else
		panthera.stop(track.animation)
	end
end


---@param self example.gui_script
---@param track example.track
---@param time number
local function panthera_set_time(self, track, time)
	if is_world_example(self) then
		events.trigger("example.scene.set_time", track.animation, track.animation_id, time)
	else
		panthera.set_time(track.animation, track.animation_id, time)
	end
end


---Play the animation of the track from the given time. Panthera continues the playback from the
---animation time, so the paused animation is resumed from the exact place it was stopped at.
---@param self example.gui_script
---@param track example.track
---@param from_time number? The time in seconds to start the playback from, default is 0
local function play_track(self, track, from_time)
	if not track.animation or not track.animation_id then
		return
	end

	from_time = from_time or 0
	local is_resume = from_time > 0

	-- Stop first, `panthera.play` resets the animation time of the playing animation
	panthera_stop(self, track)
	track.animation.current_time = from_time

	track.options.from = is_resume and from_time or nil
	track.options.is_skip_init = is_resume or nil
	panthera_play(self, track)

	-- These options belong to the current play call only, the loop starts from the beginning
	track.options.from = nil
	track.options.is_skip_init = nil

	track.display_time = from_time
end


---@param self example.gui_script
---@param track example.track
local function pause_track(self, track)
	if not track.animation or not panthera.is_playing(track.animation) then
		return
	end

	track.display_time = panthera.get_time(track.animation)
	panthera_stop(self, track)
end


---@param self example.gui_script
---@param track example.track
local function toggle_track(self, track)
	if not track.animation or not track.animation_id then
		return
	end

	if panthera.is_playing(track.animation) then
		pause_track(self, track)
		return
	end

	-- The finished animation is played from the beginning instead of being resumed
	local time = track.display_time < get_duration(track) and track.display_time or 0
	play_track(self, track, time)
end


---Pause or resume every track at once
---@param self example.gui_script
local function toggle_playback(self)
	local is_any_playing = false
	for index = 1, #self.tracks do
		local animation = self.tracks[index].animation
		is_any_playing = is_any_playing or (animation ~= nil and panthera.is_playing(animation))
	end

	for index = 1, #self.tracks do
		local track = self.tracks[index]
		if is_any_playing then
			pause_track(self, track)
		else
			toggle_track(self, track)
		end
	end
end


---Stop the track and put the nodes it animated back to their initial state
---@param self example.gui_script
---@param track example.track
local function reset_track(self, track)
	if not track.animation or not track.animation_id then
		return
	end

	-- `panthera.set_time` stops the playback and resets the nodes of the animation it stopped,
	-- so the example does not stay frozen in the middle of the dropped animation
	panthera_set_time(self, track, 0)
end


---@param self example.gui_script
---@param track example.track
---@param animation_id string|nil Pass nil to turn the track off
local function set_track_animation(self, track, animation_id)
	-- Switching to another animation resets the previous one on `play`, only turning the track
	-- off has to reset it here
	if not animation_id then
		reset_track(self, track)
	end

	track.animation_id = animation_id
	track.display_time = 0

	gui.set_enabled(track.timeline.root.node, animation_id ~= nil)

	if animation_id then
		play_track(self, track)
	end
end


---Create the animation state of the example. The GUI examples are the templates of this scene,
---the collection and the game object examples are spawned into the world by the scene script.
---@param self example.gui_script
---@param example example.example
---@return panthera.animation
local function create_animation(self, example)
	if example.template then
		gui.set_enabled(gui.get_node(example.template .. "/root"), true)

		-- An example scene can bring its own logic as a Druid widget over its template. It can
		-- handle input, create animation states of its own and add properties to the panel
		if example.widget then
			self.example_widget = self.druid:new_widget(example.widget, example.template)
		end

		return panthera.create_gui(example.animation, example.template)
	end

	return events.trigger("example.scene.spawn", example)
end


---@param self example.gui_script
---@param example example.example
local function on_example_selected(self, example)
	for index = 1, #self.tracks do
		local track = self.tracks[index]
		reset_track(self, track)
		track.animation = nil
		track.animation_id = nil
	end

	if self.example_widget then
		self.druid:remove(self.example_widget)
		self.example_widget = nil
	end

	if self.example then
		if self.example.template then
			gui.set_enabled(gui.get_node(self.example.template .. "/root"), false)
		else
			events.trigger("example.scene.despawn")
		end
	end

	self.example = example
	gui.set_text(self.node_source_path, example.source)
	clear_output(self)

	-- Both tracks animate the same example, the cloned state keeps its own playback time
	local animation = create_animation(self, example)
	self.tracks[1].animation = animation
	self.tracks[2].animation = panthera.clone_state(animation)

	self.animations_list_view:clear()
	local animation_ids = panthera.get_animations(animation)
	for index = 1, #animation_ids do
		self.animations_list_view:add_item(animation_ids[index], animation_ids[index])
	end

	self.animations_list_view:select(1)
	setup_settings(self)
end


---The playback options are mutated in place, so the loop and the speed are applied
---to the next animation cycle of both tracks without restarting them.
---@param self example.gui_script
---@param key string
---@param value any
local function set_playback_option(self, key, value)
	for index = 1, #self.tracks do
		self.tracks[index].options[key] = value
	end
end


---@param self example.gui_script
---@return string easing The name of the easing the tweener knows
local function get_easing(self)
	local easing_type = EASING_TYPES[self.easing_type_index]

	-- The linear easing has no mode
	if easing_type == "linear" then
		return "linear"
	end

	return EASING_MODES[self.easing_mode_index] .. easing_type
end


---@param self example.gui_script
---@param is_replay boolean? True to restart the tracks, the easing changes how they are played
local function apply_easing(self, is_replay)
	set_playback_option(self, "easing", get_easing(self))
	self.easing_mode_button.text_button:set_text(EASING_MODES[self.easing_mode_index])
	self.easing_type_button.text_button:set_text(EASING_TYPES[self.easing_type_index])

	if is_replay then
		for index = 1, #self.tracks do
			play_track(self, self.tracks[index])
		end
	end
end


---The panel is rebuilt for every example, so the widget of the example can append its own
---properties after the playback settings. The current values are kept in the playback options
---@param self example.gui_script
function setup_settings(self)
	self.properties_panel:clear()

	local options = self.tracks[1].options

	self.loop_checkbox = self.properties_panel:add_checkbox("Loop", options.is_loop, function(value)
		set_playback_option(self, "is_loop", value)
	end)

	self.easing_mode_button = self.properties_panel:add_button("Ease Mode", EASING_MODES[self.easing_mode_index], function()
		self.easing_mode_index = self.easing_mode_index % #EASING_MODES + 1
		apply_easing(self, true)
	end)
	self.easing_mode_button.on_reset:subscribe(function()
		self.easing_mode_index = DEFAULT_EASING_MODE
		apply_easing(self, true)
	end)

	self.easing_type_button = self.properties_panel:add_button("Ease Type", EASING_TYPES[self.easing_type_index], function()
		self.easing_type_index = self.easing_type_index % #EASING_TYPES + 1
		apply_easing(self, true)
	end)
	self.easing_type_button.on_reset:subscribe(function()
		self.easing_type_index = DEFAULT_EASING_TYPE
		apply_easing(self, true)
	end)

	local speed_slider = self.properties_panel:add_slider("Speed", self.speed_value, function(value)
		self.speed_value = value
		set_playback_option(self, "speed", math.max(value * MAX_SPEED, 0.1))
	end)
	speed_slider:set_text_function(function(value)
		return string.format("x%.2f", math.max(value * MAX_SPEED, 0.1))
	end)
	speed_slider.on_reset:subscribe(function()
		self.speed_value = 1 / MAX_SPEED
		speed_slider:set_value(self.speed_value)
		set_playback_option(self, "speed", 1)
	end)

	if self.example_widget and self.example_widget.properties_control then
		self.example_widget:properties_control(self.properties_panel)
	end
end


---Selecting an animation brings the easing back to the default, so a new animation is always
---shown as it was authored. The mode is kept, the linear type ignores it anyway
---@param self example.gui_script
local function reset_easing(self)
	if self.easing_type_index == DEFAULT_EASING_TYPE then
		return
	end

	self.easing_type_index = DEFAULT_EASING_TYPE
	apply_easing(self, false)
end


---@param self example.gui_script
---@param index number
---@return example.track
local function create_track(self, index)
	local is_primary = index == 1

	---@type example.track
	local track = {
		timeline = self.druid:new_widget(timeline, is_primary and "timeline" or "timeline_second") --[[@as example.timeline]],
		options = {
			is_loop = IS_LOOP_BY_DEFAULT,
			easing = EASING_TYPES[DEFAULT_EASING_TYPE],
			speed = 1,
		},
		animation = nil,
		animation_id = nil,
		display_time = 0,
	}

	track.timeline:set_accent(is_primary and ACCENT_PRIMARY or ACCENT_SECONDARY)

	local container = is_primary and self.container_timeline or self.container_timeline_second
	container:add_container(track.timeline.root)

	-- Events restore the script context of their subscriber, so these callbacks always run
	-- in the GUI context even when Panthera calls them from the scene script
	track.options.callback = event.create(function()
		if not track.options.is_loop then
			track.display_time = get_duration(track)
		end
	end)
	track.options.callback_event = event.create(function(event_id, node, string_value, number_value)
		local text = "event: " .. event_id
		if string_value then
			text = text .. " \"" .. string_value .. "\""
		end
		if number_value and number_value ~= 0 then
			text = text .. " = " .. string.format("%.0f", number_value)
		end
		add_output(self, event_id, text)
	end)

	track.timeline.on_scrub:subscribe(function(progress)
		if not track.animation or not track.animation_id then
			return
		end

		local time = progress * get_duration(track)
		panthera_set_time(self, track, time)
		track.display_time = time
	end)

	track.timeline.on_play_click:subscribe(function()
		toggle_track(self, track)
	end)

	return track
end


---@param self example.gui_script
local function stop_play_all(self)
	if not self.play_all then
		return
	end

	self.play_all = nil
	self.examples_list_view:set_header_button_text("Play All")
end


---@param self example.gui_script
local function play_all_advance(self)
	local state = self.play_all
	state.is_advancing = true

	state.animation_index = state.animation_index + 1
	if state.animation_index <= #self.animations_list_view.items then
		self.animations_list_view:select(state.animation_index)
		state.is_advancing = false
		return
	end

	state.example_index = state.example_index + 1
	if state.example_index > #self.examples_list_view.items then
		state.is_advancing = false
		stop_play_all(self)
		return
	end

	-- Selecting the example fills the animations list and plays its first animation
	state.animation_index = 1
	self.examples_list_view:select(state.example_index)
	state.is_advancing = false
end


---The run starts from the selected animation of the selected example and goes to the end of
---the list. The playback speed is the one set in the panel, only the loop has to be dropped:
---a looped animation never ends, so the run would never leave it.
---@param self example.gui_script
local function start_play_all(self)
	self.loop_checkbox:set_value(false)
	set_playback_option(self, "is_loop", false)

	self.play_all = {
		example_index = self.examples_list_view.selected_index or 1,
		animation_index = self.animations_list_view.selected_index or 1,
		is_advancing = true,
	}
	self.examples_list_view:set_header_button_text("Stop")
	self.animations_list_view:select(self.play_all.animation_index)
	self.play_all.is_advancing = false
end


---A click of the user takes the control back from the Play All run
---@param self example.gui_script
local function stop_play_all_on_user_input(self)
	if self.play_all and not self.play_all.is_advancing then
		stop_play_all(self)
	end
end


---@param self example.gui_script
local function setup_components(self)
	self.examples_list_view = self.druid:new_widget(list_view, "examples_list_view") --[[@as example.list_view]]
	self.examples_list_view:set_header("Examples")
	self.container_examples:add_container(self.examples_list_view.root)
	self.examples_list_view.on_select:subscribe(function(example)
		stop_play_all_on_user_input(self)
		on_example_selected(self, example)
	end)
	self.examples_list_view:set_header_button("Play All", function()
		if self.play_all then
			stop_play_all(self)
		else
			start_play_all(self)
		end
	end)

	self.animations_list_view = self.druid:new_widget(list_view, "animations_list_view", nil, 0.55) --[[@as example.list_view]]
	self.animations_list_view:set_header("Animations")
	self.animations_list_view:set_secondary_enabled(true)
	self.container_animations:add_container(self.animations_list_view.root)

	self.animations_list_view.on_select:subscribe(function(animation_id)
		stop_play_all_on_user_input(self)
		reset_easing(self)
		set_track_animation(self, self.tracks[1], animation_id)
		set_track_animation(self, self.tracks[2], nil)
	end)
	self.animations_list_view.on_select_secondary:subscribe(function(animation_id)
		stop_play_all_on_user_input(self)
		set_track_animation(self, self.tracks[2], animation_id)
	end)

	self.properties_panel = self.druid:new_widget(properties_panel, "properties_panel") --[[@as example.properties_panel]]
	self.properties_panel:set_header("Playback")
	self.container_settings:add_container(self.properties_panel.root)

	self.tracks = { create_track(self, 1), create_track(self, 2) }
	gui.set_enabled(self.tracks[2].timeline.root.node, false)

	self.druid:new_hotkey("key_space", function()
		toggle_playback(self)
	end)
	self.druid:new_hotkey("key_up", function()
		self.animations_list_view:select_shifted(-1)
	end)
	self.druid:new_hotkey("key_down", function()
		self.animations_list_view:select_shifted(1)
	end)
end


---@param self example.gui_script
local function setup_examples(self)
	for section_index = 1, #examples_list do
		local section = examples_list[section_index]
		self.examples_list_view:add_section(section.name)

		for index = 1, #section.examples do
			local example = section.examples[index]
			if example.template then
				gui.set_enabled(gui.get_node(example.template .. "/root"), false)
			end
			self.examples_list_view:add_item(example.name, example)
		end
	end

	self.examples_list_view:select(1)
end


---@param self example.gui_script
function init(self)
	panthera.set_logger(log.get_logger("panthera"))

	self.output = {}
	self.easing_mode_index = DEFAULT_EASING_MODE
	self.easing_type_index = DEFAULT_EASING_TYPE
	self.speed_value = 1 / MAX_SPEED

	self.node_source_path = gui.get_node("text_source_path")
	self.node_memory_usage = gui.get_node("text_memory_usage")
	self.node_text_output = gui.get_node("text_output")
	gui.set_text(gui.get_node("text_version"), "Runtime for Defold " .. sys.get_engine_info().version)

	self.druid = druid.new(self)
	setup_layout(self)
	setup_components(self)
	setup_settings(self)

	window.set_listener(function(_, window_event)
		druid.on_window_callback(window_event)
	end)
end


---@param self example.gui_script
function final(self)
	self.druid:final()
end


---@param self example.gui_script
---@param dt number
function update(self, dt)
	self.druid:update(dt)

	-- The window size is not known yet on the first frames in HTML5 builds: both the container
	-- layout and the screen space conversions are invalid until it is. Refresh the layout and
	-- fill the examples list as soon as the size is available
	if not self.is_window_ready and window.get_size() > 0 then
		self.is_window_ready = true
		druid.on_window_callback(window.WINDOW_EVENT_RESIZED)
		setup_examples(self)
	end

	-- The Play All run steps to the next animation as soon as the primary track is over
	local primary = self.tracks[1]
	if self.play_all and primary.animation and primary.animation_id and not panthera.is_playing(primary.animation) then
		play_all_advance(self)
	end

	self.memory_timer = (self.memory_timer or 0) + dt
	if self.memory_timer > 0.5 then
		self.memory_timer = 0
		gui.set_text(self.node_memory_usage, string.format("Lua memory: %.0f KB", collectgarbage("count")))
	end

	for index = 1, #self.tracks do
		local track = self.tracks[index]
		if track.animation and track.animation_id then
			local is_playing = panthera.is_playing(track.animation)
			if is_playing then
				track.display_time = panthera.get_time(track.animation)
			end

			track.timeline:set_state(track.animation_id, track.display_time, get_duration(track), is_playing)
		else
			track.timeline:set_state(nil, 0, 0, false)
		end
	end
end


---@param self example.gui_script
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end


---@param self example.gui_script
---@param action_id hash
---@param action action
function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end

local panthera = require("panthera.panthera")
local animation = require("example.example_go_collection_path.collection_path_panthera")

function init(self)
	-- Script is inside /wrapper — naming context is not bootstrap root.
	-- This is the case where go.get_id("panthera") != hash("/panthera").

	-- Flat collection from factory: create_go(anim, nil, objects)
	local objects_flat = collectionfactory.create("#factory_flat")
	go.set_position(vmath.vector3(240, 160, 0), objects_flat[hash("/panthera")])
	local flat = panthera.create_go(animation, nil, objects_flat)
	panthera.play(flat, "default", panthera.OPTIONS_LOOP)

	-- Nested collection from factory: create_go(anim, "target", objects)
	local objects_nested = collectionfactory.create("#factory_nested")
	go.set_position(vmath.vector3(720, 160, 0), objects_nested[hash("/target/panthera")])
	local nested = panthera.create_go(animation, "target", objects_nested)
	panthera.play(nested, "default", panthera.OPTIONS_LOOP)
end

local log = require("log.log")
local druid = require("druid.druid")
local panthera = require("panthera.panthera")

local list_view = require("example2.components.list_view.list_view")
local timeline = require("example2.components.timeline.timeline")
local properties_panel = require("example2.components.properties_panel.properties_panel")
local examples_list = require("example2.examples.examples_list")

local OUTPUT_LINES = 8
local MAX_SPEED = 3

---The easing is applied over the whole animation timeline. Panthera plays the animation
---with a tweener instead of the timer when the easing is not "linear".
local EASINGS = {
	"linear",
	"insine", "outsine", "inoutsine",
	"inquad", "outquad", "inoutquad",
	"incubic", "outcubic", "inoutcubic",
	"inexpo", "outexpo", "inoutexpo",
	"inback", "outback", "inoutback",
	"inelastic", "outelastic",
	"inbounce", "outbounce",
}

---@class example2.gui_script
---@field druid druid.instance
---@field examples_list_view example2.list_view
---@field animations_list_view example2.list_view
---@field properties_panel example2.properties_panel
---@field timeline example2.timeline
---@field example example2.example|nil The currently selected example
---@field animation panthera.animation|nil The animation state of the selected example
---@field animation_id string|nil The currently selected animation id
---@field play_options panthera.options The playback options, reused between the plays


---Containers describe the layout of the GUI scene. The components are placed inside them,
---so the layout can be changed in the GUI scene without touching the code.
---@param self example2.gui_script
local function setup_layout(self)
	self.container_root = self.druid:new_container("root") --[[@as druid.container]]

	self.container_left = self.container_root:add_container("container_left", "stretch_y")
	self.container_header = self.container_left:add_container("container_header")
	self.container_examples = self.container_left:add_container("container_examples")

	self.container_right = self.container_root:add_container("container_right", "stretch_y")
	self.container_animations = self.container_right:add_container("container_animations")
	self.container_settings = self.container_right:add_container("container_settings")

	self.container_center = self.container_root:add_container("container_center")
	self.container_timeline = self.container_center:add_container("container_timeline", "stretch_x")
end


---Append the line to the output. The repeated lines are collapsed into a single one,
---so the events triggered every frame are not flooding the output.
---@param self example2.gui_script
---@param id string
---@param text string
local function add_output(self, id, text)
	local last = self.output[#self.output]
	if last and last.id == id then
		last.text = text
		last.count = last.count + 1
	else
		table.insert(self.output, { id = id, text = text, count = 1 })
	end

	while #self.output > OUTPUT_LINES do
		table.remove(self.output, 1)
	end

	local lines = {}
	for index = 1, #self.output do
		local line = self.output[index]
		lines[index] = line.count > 1 and (line.text .. "  x" .. line.count) or line.text
	end

	gui.set_text(self.node_text_output, table.concat(lines, "\n"))
end


---@param self example2.gui_script
local function clear_output(self)
	self.output = {}
	gui.set_text(self.node_text_output, "")
end


---@param self example2.gui_script
---@return number duration The duration of the selected animation in seconds
local function get_duration(self)
	if not self.animation or not self.animation_id then
		return 0
	end

	return panthera.get_duration(self.animation, self.animation_id)
end


---Play the selected animation from the given time. Panthera continues the playback from the
---animation time, so the paused animation is resumed from the exact place it was stopped at.
---@param self example2.gui_script
---@param from_time number? The time in seconds to start the playback from, default is 0
local function play_animation(self, from_time)
	if not self.animation or not self.animation_id then
		return
	end

	from_time = from_time or 0
	local is_resume = from_time > 0

	-- Stop first, `panthera.play` resets the animation time of the playing animation
	panthera.stop(self.animation)
	self.animation.current_time = from_time

	self.play_options.from = is_resume and from_time or nil
	self.play_options.is_skip_init = is_resume or nil
	panthera.play(self.animation, self.animation_id, self.play_options)

	-- These options belong to the current play call only, the loop starts from the beginning
	self.play_options.from = nil
	self.play_options.is_skip_init = nil

	self.display_time = from_time
end


---@param self example2.gui_script
local function pause_animation(self)
	if not self.animation or not panthera.is_playing(self.animation) then
		return
	end

	self.display_time = panthera.get_time(self.animation)
	panthera.stop(self.animation)
end


---@param self example2.gui_script
local function toggle_playback(self)
	if not self.animation or not self.animation_id then
		return
	end

	if panthera.is_playing(self.animation) then
		pause_animation(self)
		return
	end

	-- The finished animation is played from the beginning instead of being resumed
	local time = self.display_time < get_duration(self) and self.display_time or 0
	play_animation(self, time)
end


---Selecting the animation always restarts it, so the same animation can be replayed
---by clicking on it once again even when the loop is disabled.
---@param self example2.gui_script
---@param animation_id string
local function on_animation_selected(self, animation_id)
	self.animation_id = animation_id
	play_animation(self)
end


---@param self example2.gui_script
---@param example example2.example
local function on_example_selected(self, example)
	if self.animation then
		panthera.stop(self.animation)
		self.animation = nil
		self.animation_id = nil
	end

	if self.example then
		gui.set_enabled(gui.get_node(self.example.template .. "/root"), false)
	end

	self.example = example
	gui.set_enabled(gui.get_node(example.template .. "/root"), true)
	gui.set_text(self.node_text_gui_path, example.gui_path)
	clear_output(self)

	self.animation = panthera.create_gui(example.animation, example.template)

	self.animations_list_view:clear()
	local animation_ids = panthera.get_animations(self.animation)
	for index = 1, #animation_ids do
		self.animations_list_view:add_item(animation_ids[index], animation_ids[index])
	end

	self.animations_list_view:select(1)
end


---The playback options are mutated in place, so the loop and the speed are applied
---to the next animation cycle without restarting the animation.
---@param self example2.gui_script
local function setup_settings(self)
	self.properties_panel:clear()

	self.properties_panel:add_checkbox("Loop", self.play_options.is_loop, function(value)
		self.play_options.is_loop = value
	end)

	local easing_index = 1
	local easing_button
	easing_button = self.properties_panel:add_button("Easing", self.play_options.easing, function()
		easing_index = easing_index % #EASINGS + 1
		self.play_options.easing = EASINGS[easing_index]
		easing_button.text_button:set_text(self.play_options.easing)

		-- The easing switches the playback between the timer and the tweener, replay it to see the change
		play_animation(self)
	end)

	local speed_slider = self.properties_panel:add_slider("Speed", 1 / MAX_SPEED, function(value)
		self.play_options.speed = math.max(value * MAX_SPEED, 0.1)
	end)
	speed_slider:set_text_function(function(value)
		return string.format("x%.2f", math.max(value * MAX_SPEED, 0.1))
	end)
end


---@param self example2.gui_script
local function setup_components(self)
	self.examples_list_view = self.druid:new_widget(list_view, "examples_list_view") --[[@as example2.list_view]]
	self.examples_list_view:set_header("Examples")
	self.container_examples:add_container(self.examples_list_view.root)
	self.examples_list_view.on_select:subscribe(function(example)
		on_example_selected(self, example)
	end)

	self.animations_list_view = self.druid:new_widget(list_view, "animations_list_view", nil, 0.55) --[[@as example2.list_view]]
	self.animations_list_view:set_header("Animations")
	self.container_animations:add_container(self.animations_list_view.root)
	self.animations_list_view.on_select:subscribe(function(animation_id)
		on_animation_selected(self, animation_id)
	end)

	self.properties_panel = self.druid:new_widget(properties_panel, "properties_panel") --[[@as example2.properties_panel]]
	self.properties_panel:set_header("Playback")
	self.container_settings:add_container(self.properties_panel.root)

	self.timeline = self.druid:new_widget(timeline, "timeline") --[[@as example2.timeline]]
	self.container_timeline:add_container(self.timeline.root)

	self.timeline.on_scrub:subscribe(function(progress)
		if not self.animation or not self.animation_id then
			return
		end

		local time = progress * get_duration(self)
		panthera.set_time(self.animation, self.animation_id, time)
		self.display_time = time
	end)

	self.timeline.on_play_click:subscribe(function()
		toggle_playback(self)
	end)

	self.druid:new_hotkey("key_space", function()
		toggle_playback(self)
	end)
	self.druid:new_hotkey("key_up", function()
		self.animations_list_view:select_shifted(-1)
	end)
	self.druid:new_hotkey("key_down", function()
		self.animations_list_view:select_shifted(1)
	end)
end


---@param self example2.gui_script
local function setup_examples(self)
	for index = 1, #examples_list do
		local example = examples_list[index]
		gui.set_enabled(gui.get_node(example.template .. "/root"), false)
		self.examples_list_view:add_item(example.name, example)
	end

	self.examples_list_view:select(1)
end


---@param self example2.gui_script
function init(self)
	panthera.set_logger(log.get_logger("panthera"))

	self.output = {}
	self.display_time = 0

	self.play_options = {
		is_loop = false,
		easing = EASINGS[1],
		speed = 1,
		callback = function(animation_id)
			if not self.play_options.is_loop then
				self.display_time = panthera.get_duration(self.animation, animation_id)
			end
		end,
		callback_event = function(event_id, node, string_value, number_value)
			local text = "event: " .. event_id
			if string_value then
				text = text .. " \"" .. string_value .. "\""
			end
			if number_value and number_value ~= 0 then
				text = text .. " = " .. string.format("%.0f", number_value)
			end
			add_output(self, event_id, text)
		end,
	}

	self.node_text_gui_path = gui.get_node("text_gui_path")
	self.node_text_output = gui.get_node("text_output")
	gui.set_text(gui.get_node("text_version"), "Runtime for Defold " .. sys.get_engine_info().version)

	self.druid = druid.new(self)
	setup_layout(self)
	setup_components(self)
	setup_settings(self)

	window.set_listener(function(_, event)
		druid.on_window_callback(event)
	end)
end


---@param self example2.gui_script
function final(self)
	self.druid:final()
end


---@param self example2.gui_script
---@param dt number
function update(self, dt)
	self.druid:update(dt)

	-- The window size is not known yet on the first frames in HTML5 builds: both the container
	-- layout and the screen space conversions are invalid until it is. Refresh the layout and
	-- fill the examples list as soon as the size is available
	if not self.is_window_ready and window.get_size() > 0 then
		self.is_window_ready = true
		druid.on_window_callback(window.WINDOW_EVENT_RESIZED)
		setup_examples(self)
	end

	if self.animation and self.animation_id then
		local is_playing = panthera.is_playing(self.animation)
		if is_playing then
			self.display_time = panthera.get_time(self.animation)
		end

		self.timeline:set_state(self.animation_id, self.display_time, get_duration(self), is_playing)
	else
		self.timeline:set_state(nil, 0, 0, false)
	end
end


---@param self example2.gui_script
---@param message_id hash
---@param message table
---@param sender url
function on_message(self, message_id, message, sender)
	self.druid:on_message(message_id, message, sender)
end


---@param self example2.gui_script
---@param action_id hash
---@param action action
function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end
